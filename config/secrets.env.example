# ELİŞA API Anahtar Şablonu — ~/.config/elisha/secrets.env olarak kaydet
# Tümü ÜCRETSİZ katmanlarla çalışır. En az biri (tercihen GROQ + OPENROUTER) yeterli.

# Groq — console.groq.com (hızlı birincil beyin + whisper STT)
GROQ_API_KEY=gsk_xxx

# OpenRouter — openrouter.ai/keys (yedek beyin + görü analizi + ücretsiz modeller)
OPENROUTER_API_KEY=sk-or-v1-xxx

# Google Gemini — aistudio.google.com/apikey (Live ses + yedek beyin)
GEMINI_API_KEY=xxx

# Cerebras — cloud.cerebras.net (opsiyonel, kart ister)
CEREBRAS_API_KEY=

# NVIDIA NIM — build.nvidia.com (opsiyonel)
NVIDIA_API_KEY=

#!/bin/bash
# ELİŞA macOS App Launcher
# Not: LaunchServices ('open') ile başlatılan süreçler TCC nedeniyle
# ~/Desktop dosyalarını okuyamayabilir. Bu yüzden önce LaunchAgent'a
# delege ederiz; terminal bağlamında doğrudan çalıştırma da mümkündür.
exec > /tmp/elisha-app.log 2>&1

SCRIPT_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
echo "$(date): ELİŞA başlatılıyor... (dir: $SCRIPT_DIR)"
cd "$SCRIPT_DIR" || exit 1

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

# ── 0) Zaten çalışıyor mu? ────────────────────────────────────────────────
elisha_up() {
    curl -s --max-time 2 http://localhost:8765/api/status >/dev/null 2>&1
}
if elisha_up; then
    echo "$(date): ELİŞA zaten çalışıyor, çıkılıyor."
    exit 0
fi

# ── 1) Ollama'yı hazırla (bloklamadan) ────────────────────────────────────
ollama_up() {
    curl -s --max-time 2 http://localhost:11434/api/tags >/dev/null 2>&1
}
if ! ollama_up; then
    if command -v ollama &>/dev/null; then
        ollama serve >> /tmp/ollama.log 2>&1 &
        sleep 3
    fi
fi
if ! ollama_up; then
    # Yeni Ollama.app sürümleri CLI'da 'serve' komutunu reddediyor;
    # paketin içindeki sunucu ikilisini doğrudan çalıştır
    if [ -x "/Applications/Ollama.app/Contents/Resources/Ollama" ]; then
        OLLAMA_HOST=127.0.0.1:11434 /Applications/Ollama.app/Contents/Resources/Ollama serve >> /tmp/ollama.log 2>&1 &
        sleep 3
    fi
fi
ollama_up && echo "$(date): Ollama hazır" || echo "$(date): UYARI - Ollama başlatılamadı (Groq yeterli)"

# ── 2) Secrets yükle ──────────────────────────────────────────────────────
if [ -f "$HOME/.config/elisha/secrets.env" ]; then
    set -a; source "$HOME/.config/elisha/secrets.env"; set +a
fi

# ── 3) LaunchAgent varsa ona delege et (TCC güvenli yol) ──────────────────
UID_N="$(id -u)"
LABEL="com.elisha.autostart"
if launchctl print "gui/$UID_N/$LABEL" &>/dev/null; then
    echo "$(date): LaunchAgent üzerinden başlatılıyor..."
    launchctl kickstart "gui/$UID_N/$LABEL"
    for i in $(seq 1 16); do
        sleep 1
        if elisha_up; then
            echo "$(date): ELİŞA hazır ($i sn)."
            exit 0
        fi
    done
    echo "$(date): LaunchAgent yanıt vermedi, doğrudan denenecek..."
else
    PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
    if [ -f "$PLIST" ]; then
        launchctl load "$PLIST" 2>/dev/null
        for i in $(seq 1 16); do
            sleep 1
            if elisha_up; then
                echo "$(date): ELİŞA hazır (load + $i sn)."
                exit 0
            fi
        done
    fi
fi

# ── 4) Son çare: doğrudan çalıştır (terminal bağlamında TCC izinli) ───────
if [ -f "$SCRIPT_DIR/venv/bin/activate" ]; then
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/venv/bin/activate" 2>/dev/null
fi
echo "$(date): python3 doğrudan başlatılıyor..."
exec "$SCRIPT_DIR/venv/bin/python3" -u app/desktop_app.py 2>/dev/null || exec python3 -u app/desktop_app.py
